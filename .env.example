# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O arquivo .env fica só no seu computador — ele NÃO vai para o GitHub.

# Endereço de entrada do Viver (a página de login)
VIVER_URL=https://endereco-do-viver.com.br

# Seu usuário e senha do Viver
VIVER_USUARIO=
VIVER_SENHA=

# 1 = abre o navegador na tela para você ver o robô trabalhando
# 0 = trabalha escondido (padrão)
VIVER_MOSTRAR_NAVEGADOR=0

# De quantos em quantos minutos a passagem é atualizada sozinha
ATUALIZAR_A_CADA_MIN=5
