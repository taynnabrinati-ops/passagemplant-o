# Copie este arquivo para ".env" e ajuste. O .env NÃO vai para o GitHub.

# Página de login do Vivver
VIVER_URL=https://macae-rj.vivver.com/login

# Bloco que já vem escolhido ao abrir a passagem (dá para trocar na tela)
VIVER_SETOR_PADRAO=Politrauma 3

# De quantos em quantos minutos a passagem é atualizada sozinha
ATUALIZAR_A_CADA_MIN=5

# Minutos sem uso até a sessão de uma pessoa ser encerrada
SESSAO_INATIVIDADE_MIN=120

# Só para o "npm run viver:explorar" (mapear as telas). O site em si NÃO usa
# estes dois: cada pessoa entra com o próprio login.
VIVER_USUARIO=
VIVER_SENHA=

# 1 = mostra o navegador do robô na tela (para depurar)
VIVER_MOSTRAR_NAVEGADOR=0
